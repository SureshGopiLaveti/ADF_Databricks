{
	"name": "df_removing_duplicates",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_csv_file_with_duplicates",
						"type": "DatasetReference"
					},
					"name": "duplicateDataSource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_duplicatesRemovedData",
						"type": "DatasetReference"
					},
					"name": "uniquedata"
				}
			],
			"transformations": [
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          custId as string,",
				"          custName as string,",
				"          itemName as string,",
				"          quantity as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> duplicateDataSource",
				"duplicateDataSource aggregate(groupBy(custId),",
				"     each(match(name != 'custId'), $$ = first($$))) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> uniquedata"
			]
		}
	}
}