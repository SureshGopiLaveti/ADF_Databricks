{
	"name": "df_removing_duplicates",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_duplicateFile",
						"type": "DatasetReference"
					},
					"name": "duplicateDataSource"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          custId as string,",
				"          custName as string,",
				"          itemName as string,",
				"          quantity as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> duplicateDataSource",
				"duplicateDataSource aggregate(groupBy(custId),",
				"     column1 = ERROR_FUNCTION(''),",
				"          each(match(), ERROR_FUNCTION('') = ERROR_FUNCTION(''))) ~> aggregate1"
			]
		}
	}
}