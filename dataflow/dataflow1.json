{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText1",
						"type": "DatasetReference"
					},
					"name": "Practice1",
					"description": "Import data from DelimitedText1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ARTICLE_NUMBER as string,",
				"          WIN_NUMBER as integer,",
				"          SITE as integer,",
				"          MERCHANDISE_CATEGORY as string,",
				"          REPORT_DATE as string,",
				"          BASE_UOM as string,",
				"          QUANTITY as string,",
				"          EXT_TIME as string,",
				"          SITE_CATEGORY as string,",
				"          MRP_TYPE as string,",
				"          HELD_STOCK as string,",
				"          GTIN_NUMBER as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Practice1",
				"Practice1 derive(alter_column_reportDate = currentTimestamp()) ~> derivedColumn1",
				"derivedColumn1 filter(contains([1,2,3,4], SITE)) ~> filter1"
			]
		}
	}
}