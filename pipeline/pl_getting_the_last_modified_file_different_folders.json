{
	"name": "pl_getting_the_last_modified_file_different_folders",
	"properties": {
		"activities": [
			{
				"name": "metada_of_the_container",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_container_meta_data",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "ForEach2",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Filter1",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Filter1').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Execute Pipeline1",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "pl_nested_pipeline",
									"type": "PipelineReference"
								},
								"waitOnCompletion": false,
								"parameters": {
									"Folder_name": {
										"value": "@item().name",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			},
			{
				"name": "Filter1",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "metada_of_the_container",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('metada_of_the_container').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@and(equals(item().type,'Folder'),\n   or(equals(item().name,'result_data_frame' ),\n   equals(item().name,'OlderThan5Days' )))",
						"type": "Expression"
					}
				}
			}
		],
		"variables": {
			"folder_name": {
				"type": "String"
			},
			"temp_file_name": {
				"type": "String"
			},
			"flder_names": {
				"type": "Array"
			},
			"FOLDER_NAME_FROM_ARRAY": {
				"type": "String"
			}
		},
		"annotations": []
	}
}