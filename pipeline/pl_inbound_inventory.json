{
	"name": "pl_inbound_inventory",
	"properties": {
		"activities": [
			{
				"name": "File arrival",
				"type": "Until",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(variables('Completed existence'),0)",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Metadata_files_existence",
							"type": "GetMetadata",
							"dependsOn": [],
							"policy": {
								"timeout": "0.00:50:00",
								"retry": 10,
								"retryIntervalInSeconds": 300,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "ds_inventory_inbbound_yearmonthday_dynamic",
									"type": "DatasetReference",
									"parameters": {
										"current_day": {
											"value": "@concat(formatDateTime(utcNow(),'yyyy/MM/dd'))",
											"type": "Expression"
										}
									}
								},
								"fieldList": [
									"exists",
									"childItems"
								],
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "DelimitedTextReadSettings"
								}
							}
						},
						{
							"name": "If Condition1",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Metadata_files_existence",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@activity('Metadata_files_existence').output.exists",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "Filter1",
										"type": "Filter",
										"dependsOn": [],
										"userProperties": [],
										"typeProperties": {
											"items": {
												"value": "@activity('Metadata_files_existence').output.childItems",
												"type": "Expression"
											},
											"condition": {
												"value": "@contains(item().name,'.completed')",
												"type": "Expression"
											}
										}
									},
									{
										"name": "Set variable1",
										"type": "SetVariable",
										"dependsOn": [
											{
												"activity": "Filter1",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"variableName": "Completed existence",
											"value": {
												"value": "@activity('Filter1').output.FilteredItemsCount",
												"type": "Expression"
											}
										}
									}
								]
							}
						}
					],
					"timeout": "0.00:50:00"
				}
			},
			{
				"name": "failed due to no file existence",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "File arrival",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": {
						"value": "@activity('Metadata_files_existence').output",
						"type": "Expression"
					},
					"errorCode": {
						"value": "@activity('Metadata_files_existence').output",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Moving completed file to archive folder",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "completed file name",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_complete_file_source",
						"type": "DatasetReference",
						"parameters": {
							"directory": {
								"value": "@formatDateTime(utcNow(),'yyyy/MM/dd')",
								"type": "Expression"
							},
							"file_name": {
								"value": "@variables('Completed file name')",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_complete_file_source",
						"type": "DatasetReference",
						"parameters": {
							"directory": {
								"value": "@concat(formatDateTime(utcNow(),'yyyy/MM/dd'),'/Archieve')",
								"type": "Expression"
							},
							"file_name": {
								"value": "@variables('Completed file name')",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "completed file name",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "File arrival",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Completed file name",
					"value": {
						"value": "@activity('Filter1').output.Value[0].name",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Failed upon moving completed file to archive",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "Moving completed file to archive folder",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": {
						"value": "@activity('Moving completed file to archive folder').output",
						"type": "Expression"
					},
					"errorCode": {
						"value": "@activity('Moving completed file to archive folder').output",
						"type": "Expression"
					}
				}
			}
		],
		"variables": {
			"Completed existence": {
				"type": "Integer"
			},
			"Completed file name": {
				"type": "String"
			}
		},
		"annotations": []
	}
}