{
	"name": "pl_inbound_inventory",
	"properties": {
		"activities": [
			{
				"name": "File arrival",
				"type": "Until",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(variables('Completed files count'),0)",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Metadata_files_existence",
							"type": "GetMetadata",
							"dependsOn": [],
							"policy": {
								"timeout": "0.00:50:00",
								"retry": 10,
								"retryIntervalInSeconds": 300,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "ds_inventory_inbbound_yearmonthday_dynamic",
									"type": "DatasetReference",
									"parameters": {
										"currentday": {
											"value": "@{concat('I0132/',formatDateTime(utcNow(),'yyyy/MM/dd'))}",
											"type": "Expression"
										}
									}
								},
								"fieldList": [
									"exists",
									"childItems"
								],
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "DelimitedTextReadSettings"
								}
							}
						},
						{
							"name": "If Condition1",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Metadata_files_existence",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@activity('Metadata_files_existence').output.exists",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "Filter1",
										"type": "Filter",
										"dependsOn": [],
										"userProperties": [],
										"typeProperties": {
											"items": {
												"value": "@activity('Metadata_files_existence').output.childItems",
												"type": "Expression"
											},
											"condition": {
												"value": "@contains(item().name,'.completed')",
												"type": "Expression"
											}
										}
									},
									{
										"name": "Set variable1",
										"type": "SetVariable",
										"dependsOn": [
											{
												"activity": "Filter1",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"variableName": "Completed files count",
											"value": {
												"value": "@activity('Filter1').output.FilteredItemsCount",
												"type": "Expression"
											}
										}
									}
								]
							}
						}
					],
					"timeout": "0.00:50:00"
				}
			},
			{
				"name": "failed due to no file existence",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "File arrival",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": {
						"value": "@activity('Metadata_files_existence').output",
						"type": "Expression"
					},
					"errorCode": {
						"value": "@activity('Metadata_files_existence').output",
						"type": "Expression"
					}
				}
			}
		],
		"variables": {
			"fileexists": {
				"type": "Boolean"
			},
			"Completed files count": {
				"type": "Integer"
			}
		},
		"annotations": []
	}
}